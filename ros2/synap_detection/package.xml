<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>synap_detection</name>
  <version>0.1.0</version>
  <description>YOLO multi-target detector publishing vision_msgs/Detection2DArray
  for the SynapLine tracker-lock workflow (Unity gimbal -> detections ->
  joystick-selected ROI -> hybrid_tracker_vpi).</description>
  <maintainer email="teymurmammadzada@yahoo.com">Teymur</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
