<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openvins_matlab_bridge</name>
  <version>0.1.0</version>
  <description>Relay the Unity NavCamera stream into OpenVINS (MATLAB-sim + Unity/Cesium pipeline). No PX4 dependency.</description>
  <maintainer email="teymur@todo.todo">Teymur</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
